{
  "bundle": {
    "active": true,
    "category": "BoardGame",
    "copyright": "",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "Chess Review",
        "displayLanguageSelector": false
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "publisher": "Chess Reviewer contributors",
    "shortDescription": "Local-first chess game review",
    "longDescription": "Analyze PGN games with bundled Stockfish and offline Vietnamese commentary.",
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": "-"
    },
    "resources": {
      "../sound/": "sound/",
      "../LICENSE": "LICENSE",
      "../docs/LICENSE_NOTICES.md": "LICENSE_NOTICES.md",
      "resources/stockfish/stockfish.exe": "stockfish/stockfish.exe"
    },
    "targets": ["nsis"]
  },
  "build": {
    "beforeDevCommand": "pnpm start-vite",
    "beforeBuildCommand": "pnpm build-vite",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "productName": "ChessReview",
  "mainBinaryName": "ChessReview",
  "version": "1.0.0",
  "identifier": "org.chessreviewer.desktop",
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "chessreview"
        ]
      }
    },
    "cli": {
      "args": [
        {
          "name": "file",
          "index": 1,
          "takesValue": true
        },
        {
          "name": "review-url",
          "short": "r",
          "description": "Run a hidden Chess.com review and export raw analysis and commentary",
          "takesValue": true
        },
        {
          "name": "report-output",
          "short": "o",
          "description": "Output filename stem for the diagnostic .json and .md files",
          "takesValue": true,
          "requires": "review-url"
        }
      ]
    }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Chess Reviewer",
        "visible": false,
        "decorations": true
      }
    ],
    "security": {
      "assetProtocol": {
        "scope": [
          "**"
        ],
        "enable": true
      },
      "csp": null
    }
  }
}
