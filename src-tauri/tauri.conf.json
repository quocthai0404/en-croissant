{
  "bundle": {
    "active": true,
    "category": "BoardGame",
    "copyright": "",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "publisher": "Chess Reviewer contributors",
    "shortDescription": "Local-first chess game review",
    "longDescription": "Analyze PGN games with a locally selected UCI engine and offline Vietnamese commentary.",
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": "-"
    },
    "resources": {
      "../sound/": "sound/",
      "../LICENSE": "LICENSE",
      "../docs/LICENSE_NOTICES.md": "LICENSE_NOTICES.md"
    },
    "targets": "all"
  },
  "build": {
    "beforeDevCommand": "pnpm start-vite",
    "beforeBuildCommand": "pnpm build-vite",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "productName": "Chess Reviewer",
  "mainBinaryName": "chess-reviewer",
  "identifier": "org.chessreviewer.desktop",
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "encroissant"
        ]
      }
    },
    "cli": {
      "args": [
        {
          "name": "file",
          "index": 1,
          "takesValue": true
        }
      ]
    },
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Chess Reviewer",
        "visible": false,
        "decorations": true
      }
    ],
    "security": {
      "assetProtocol": {
        "scope": [
          "**"
        ],
        "enable": true
      },
      "csp": null
    }
  }
}
